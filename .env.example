# Public app URL (used for metadata/canonical links)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Supabase (required for production auth + database)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only key (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional: direct URL for General Manager portrait on About page
NEXT_PUBLIC_MANAGER_PHOTO_URL=https://your-cdn-or-vercel-blob-url/manager-photo.jpg
